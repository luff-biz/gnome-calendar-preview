msgid "Nothing planned"
msgstr "Rien de prévu"

msgid "Running appointments"
msgstr "Rendez-vous en cours"

msgid "Upcoming appointments"
msgstr "Prochains rendez-vous"

msgid "Upcoming appointment"
msgstr "Prochain rendez-vous"

#, javascript-format
msgid "Next %d appointments"
msgstr "Prochains rendez-vous (%d)"

msgid "Untitled"
msgstr "Sans titre"

msgid "Location"
msgstr "Lieu"

msgid "Description"
msgstr "Description"

msgid "Attendees"
msgstr "Participants"

msgid "No details"
msgstr "Aucun détail"

msgid "All day"
msgstr "Toute la journée"

msgid "Appointments"
msgstr "Rendez-vous"

msgid "Calendar"
msgstr "Calendrier"

msgid "The month calendar in the date menu"
msgstr "Le calendrier mensuel dans le menu de date"

msgid "Hide month grid"
msgstr "Masquer la grille mensuelle"

msgid "The month calendar takes up space. The header and the appointment list remain."
msgstr "Le calendrier mensuel prend de la place. Il reste l'en-tête et la liste des rendez-vous."

msgid "What is shown instead of the day list"
msgstr "Ce qui s'affiche à la place de la liste du jour"

