msgid "Nothing planned"
msgstr "Nichts geplant"

msgid "Running appointments"
msgstr "Laufende Termine"

msgid "Upcoming appointments"
msgstr "Nächste Termine"

msgid "Upcoming appointment"
msgstr "Nächster Termin"

#, javascript-format
msgid "Next %d appointments"
msgstr "Nächste %d Termine"

msgid "Untitled"
msgstr "Ohne Titel"

msgid "Location"
msgstr "Ort"

msgid "Description"
msgstr "Beschreibung"

msgid "Attendees"
msgstr "Teilnehmer"

msgid "No details"
msgstr "Keine Details"

msgid "All day"
msgstr "Ganztag"

msgid "Appointments"
msgstr "Terminliste"

msgid "Calendar"
msgstr "Kalender"

msgid "The month calendar in the date menu"
msgstr "Der Monatskalender im Datumsmenü"

msgid "Hide month grid"
msgstr "Monatsgitter ausblenden"

msgid "The month calendar takes up space. The header and the appointment list remain."
msgstr "Der Monatskalender nimmt Platz weg. Es bleiben die Kopfzeile und die Terminliste."

msgid "What is shown instead of the day list"
msgstr "Was anstelle der Tagesliste angezeigt wird"

msgid "Number of appointments"
msgstr "Anzahl der Termine"

msgid "How many of the next appointments are shown"
msgstr "Wie viele der nächsten Termine angezeigt werden"

