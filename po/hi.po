msgid "Nothing planned"
msgstr "कुछ नियोजित नहीं"

msgid "Running appointments"
msgstr "चालू अपॉइंटमेंट"

msgid "Upcoming appointments"
msgstr "आगामी अपॉइंटमेंट"

msgid "Upcoming appointment"
msgstr "आगामी अपॉइंटमेंट"

#, javascript-format
msgid "Next %d appointments"
msgstr "अगले %d अपॉइंटमेंट"

msgid "Untitled"
msgstr "बिना शीर्षक"

msgid "Location"
msgstr "स्थान"

msgid "Description"
msgstr "विवरण"

msgid "Attendees"
msgstr "प्रतिभागी"

msgid "No details"
msgstr "कोई विवरण नहीं"

msgid "All day"
msgstr "पूरे दिन"

msgid "Appointments"
msgstr "अपॉइंटमेंट"

msgid "Calendar"
msgstr "कैलेंडर"

msgid "The month calendar in the date menu"
msgstr "दिनांक मेनू में मासिक कैलेंडर"

msgid "Hide month grid"
msgstr "मासिक ग्रिड छिपाएँ"

msgid "The month calendar takes up space. The header and the appointment list remain."
msgstr "मासिक कैलेंडर जगह लेता है। शीर्षलेख और अपॉइंटमेंट सूची रहती है।"

msgid "What is shown instead of the day list"
msgstr "दिन सूची के स्थान पर क्या दिखाया जाता है"

msgid "Number of appointments"
msgstr "अपॉइंटमेंट की संख्या"

msgid "How many of the next appointments are shown"
msgstr "अगले कितने अपॉइंटमेंट दिखाए जाते हैं"

msgid "Show all-day appointments"
msgstr "पूरे दिन के अपॉइंटमेंट दिखाएँ"

msgid "Birthdays, holidays and other all-day entries"
msgstr "जन्मदिन, छुट्टियाँ और अन्य पूरे दिन की प्रविष्टियाँ"

msgid "Show past and running appointments"
msgstr "पिछले और चालू अपॉइंटमेंट दिखाएँ"

msgid "The last two finished and the current one, at 50% opacity"
msgstr "पिछले दो समाप्त और वर्तमान, 50% अस्पष्टता पर"

msgid "Preview period"
msgstr "पूर्वावलोकन अवधि"

msgid "Days into the future — automatically widened when needed"
msgstr "भविष्य में दिन — आवश्यकता पर स्वचालित रूप से बढ़ाया गया"

msgid "Behavior"
msgstr "व्यवहार"

msgid "Log to journal"
msgstr "जर्नल में लॉग करें"

msgid "For debugging: which appointments were shown"
msgstr "डिबगिंग के लिए: कौन से अपॉइंटमेंट दिखाए गए"
